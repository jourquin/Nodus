<?eclipse.ant.import?>
<!DOCTYPE project>
<project basedir="." xmlns:if="ant:if" xmlns:unless="ant:unless">
	<!--import file="build.xml"/-->

	<!-- Forward to the standalone test build so Eclipse can validate this file on its own. -->
	<target name="CleanTests" description="Removes compiled tests and test reports.">
		<ant antfile="${basedir}/build-tests.xml" target="CleanTests" inheritAll="false" />
	</target>

	<target name="Test" description="Runs the JUnit 5 unit and integration tests without opening the GUI.">
		<ant antfile="${basedir}/build-tests.xml" target="Test" inheritAll="false" />
	</target>
	
	<!-- Launches the JFlex lexer -->
	<target name="JFlex" description="Runs the JFlex lexer.">
		<java jar="${basedir}/devtools/JFlex.jar" fork="yes" failonerror="true" />
	</target>

	<!-- Launches the Build ID generator -->
	<target name="BuildId" description="Compiles and run the Build ID generator">
		<echo message="Generating a build ID" />
		<mkdir dir="classes" />
		<javac includeantruntime="false" srcdir="src" destdir="classes">
			<include name="edu/uclouvain/core/nodus/utils/BuildIdGenerator.java" />
		</javac>
		<java classname="edu.uclouvain.core.nodus.utils.BuildIdGenerator" classpath="${basedir}/classes" failonerror="true" fork="yes">
		</java>
	</target>

	<!-- Build the API documentation  -->
	
	<target name="PrepareApiDoc" description="Prepare the API doc generation.">
	    <echo message="Generating the Nodus API documentation" />
	    <delete dir="${basedir}/api" />
	    <mkdir dir="${basedir}/api" />
	</target>
	
	<property name="copyrightString" value="Copyright 1991-2026, Université catholique de Louvain (UCLouvain), Center for Operations Research and Econometrics (CORE)"/>
	    
	<target name="ApiDoc" description="Makes the javadoc API html documents.">
	    <antcall target="PrepareApiDoc" />
		<javadoc sourcepath="${basedir}/src" destdir="${basedir}/api" maxmemory="256m"
			excludepackagenames="com.bbn.openmap.layer.shape.displayindex,com.bbn.openmap.layer.image.capabilities,edu.uclouvain.core.nodus.database.sql" 
			encoding="UTF-8" docencoding="UTF-8" charset="UTF-8" 
			packagenames="com.bbn.openmap.*, edu.uclouvain.core.*" 
			author="true" version="true" use="true" 
			windowtitle="Nodus 8.6 API" 
			doctitle="Nodus" bottom="${copyrightString}"
			classpathref="Nodus.classpath" failonerror="false" />
	</target>

	<!-- Build Markdown based help pages -->
	<property name="services.workflow.md" value="${basedir}/doc/services/services-workflow.md" />
	<property name="services.workflow.html" value="${basedir}/doc/services/services-workflow.html" />

	<target name="CheckPandoc">
		<condition property="pandoc.executable" value="/opt/homebrew/bin/pandoc">
			<and>
				<not>
					<isset property="pandoc.executable" />
				</not>
				<available file="/opt/homebrew/bin/pandoc" />
			</and>
		</condition>
		<condition property="pandoc.executable" value="/usr/local/bin/pandoc">
			<and>
				<not>
					<isset property="pandoc.executable" />
				</not>
				<available file="/usr/local/bin/pandoc" />
			</and>
		</condition>
		<property name="pandoc.executable" value="pandoc" />
		<condition property="pandoc.available">
			<or>
				<available file="${pandoc.executable}" />
				<available file="${pandoc.executable}" filepath="${env.PATH}" />
				<available file="pandoc.exe" filepath="${env.PATH}" />
			</or>
		</condition>
	</target>

	<target name="RunServicesWorkflowHtml" depends="CheckPandoc" if="pandoc.available">
		<echo message="Generating ${services.workflow.html} with ${pandoc.executable}" />
		<exec executable="${pandoc.executable}" searchpath="true" failonerror="false" failifexecutionfails="false" resultproperty="services.workflow.html.result">
			<arg value="${services.workflow.md}" />
			<arg value="-f" />
			<arg value="markdown-smart" />
			<arg value="-s" />
			<arg value="--metadata" />
			<arg value="pagetitle=Service Lines Workflow" />
			<arg value="-c" />
			<arg value="../style.css" />
			<arg value="-o" />
			<arg value="${services.workflow.html}" />
		</exec>
		<condition property="services.workflow.html.failed">
			<not>
				<equals arg1="${services.workflow.html.result}" arg2="0" />
			</not>
		</condition>
		<available file="${services.workflow.html}" property="services.workflow.html.exists" />
		<condition property="services.workflow.html.missing">
			<not>
				<isset property="services.workflow.html.exists" />
			</not>
		</condition>
		<condition property="services.workflow.html.generated">
			<and>
				<equals arg1="${services.workflow.html.result}" arg2="0" />
				<isset property="services.workflow.html.exists" />
			</and>
		</condition>
	</target>

	<!-- Conditional tasks avoid displaying warning target names when no warning applies. -->
	<target name="GenerateServicesWorkflowHtml" depends="RunServicesWorkflowHtml" description="Generates doc/services/services-workflow.html from Markdown when Pandoc is available.">
		<echo unless:set="pandoc.available" level="warning" message="Pandoc not found. Skipping generation of doc/services/services-workflow.html. If Pandoc is installed outside Ant's PATH, run Ant with -Dpandoc.executable=/path/to/pandoc." />
		<echo if:set="services.workflow.html.failed" level="warning" message="Pandoc failed while generating ${services.workflow.html}. Continuing without regenerating the help page." />
		<echo if:set="services.workflow.html.missing" level="warning" message="Pandoc finished, but ${services.workflow.html} was not found." />
		<echo if:set="services.workflow.html.generated" message="Generated ${services.workflow.html}" />
	</target>

	<target name="ServicesWorkflowHtml" depends="GenerateServicesWorkflowHtml" description="Generates doc/services/services-workflow.html from Markdown when Pandoc is available." />
	

	<!-- Launches IzPack installer -->
	<path id="lib.path">
		<fileset dir="${basedir}/devtools/IzPack" includes="*.jar" />
	</path>

	<taskdef name="izpack" classname="com.izforge.izpack.ant.IzPackTask" classpathref="lib.path" />

	<!-- A failed test build propagates through Test and stops all installer work. -->
	<target name="Installer" depends="Test" description="Runs the tests, then builds the Nodus installer jar file.">
		<echo message="Creating a Nodus installer" />
		<antcall target="ServicesWorkflowHtml" />
		<antcall target="Jar" />
		<antcall target="ApiDoc" />
		<mkdir dir="${basedir}/BinaryDistribution"/>
		<izpack input="${basedir}/installer/installer.xml" output="${basedir}/BinaryDistribution/Nodus8-install.jar" installerType="standard" basedir="${basedir}" izPackDir="${basedir}" compressionLevel="0" />
	</target>

	<!-- Create jar -->
	<target name="Jar" description="Builds the Nodus jar file.">
		<echo message="Creating Nodus jar file" />
		<antcall target="clean" />
		<!-- Override build.xml to use the "release" javac option instead of "source" and "target" -->
		<mkdir dir="classes"/>
		<copy includeemptydirs="false" todir="classes">
			<fileset dir="src">
				<exclude name="**/*.launch"/>
		    	<exclude name="**/*.java"/>
		    </fileset>
		</copy>
		<javac debug="true" debuglevel="${debuglevel}" destdir="classes" includeantruntime="false" release="${target}">
			<src path="src"/>
		    <classpath refid="Nodus.classpath"/>
		</javac>
		
		
		<antcall target="BuildId" />
		<antcall target="build" />
		<jar destfile="${basedir}/nodus8.jar" basedir="${basedir}/classes" manifest="${basedir}/src/MANIFEST.MF" index="true" />
		<delete file="./classes/edu/uclouvain/core/nodus/utils/buildid.properties" />
	</target>
</project>
